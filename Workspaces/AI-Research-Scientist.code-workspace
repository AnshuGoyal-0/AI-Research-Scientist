{
  "folders": [
    {
      "name": "Calculator Project",
      "path": "."
    }
  ],
  "settings": {
    /* Python Environment Settings */
    "python-envs.pythonProjects": [
      {
        "path": "Calculator (CLI + GUI)",
        "envManager": "ms-python.python:venv",
        "packageManager": "ms-python.python:pip"
      }
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/Calculator (CLI + GUI)/.venv/bin/python",
    "python.analysis.typeCheckingMode": "basic",

    /* 🏎️ Jupyter Performance & Output Optimization */
    "notebook.output.textLineLimit": 100,             // Prevents large print loops from freezing the UI
    "notebook.cellToolbarLocation": "hidden",         // Hides unneeded buttons to speed up cell switching
    "notebook.scrolling.animation": false,            // Instantly jumps to cells instead of rendering animations
    "notebook.experimental.generateOutputsOnSave": false, // Speeds up save times on huge notebooks
    "notebook.formatOnSave.enabled": true,            // Automatically keeps your cells beautiful on save

    /* 🛠️ Jupyter Workspace Controls */
    "notebook.lineNumbers": "on",                     // Crucial for debugging error tracebacks instantly
    "notebook.outline.showCodeCells": true,           // Allows navigating your notebook via code signatures
    "notebook.compactView": true,                     // Reduces padding so you see more code per screen

    /* Editor & Code Automation */
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.rulers": [88],
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",

    /* Files & Cleanliness */
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ipynb_checkpoints": true,                 // Hides messy local Jupyter backup files
      "**/.venv": false
    },

    /* UI & Terminal Optimizations */
    "workbench.iconTheme": "vscode-icons",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.scrollback": 10000
  },

  /* Recommended Extensions for Data Science / Jupyter */
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "ms-toolsai.jupyter",       // Core Jupyter support
      "ms-toolsai.jupyter-renderers", // Optimized rendering for plots and dataframes
      "ms-toolsai.data-wrangler"  // Extremely fast, native GUI tool for viewing large datasets/dataframes
    ]
  }
}
